# AgentLab — optional cloud auth (Supabase).
# Leave these UNSET to run AgentLab in local-only mode (no account, no backend).
# Set them to enable email/password accounts and cross-device progress sync.
#
# Copy this file to `.env.local` and fill in values from your Supabase project:
#   Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notes:
# - The anon key is safe to expose to the browser (that's its purpose); security
#   is enforced by row-level security in supabase/schema.sql, not by hiding it.
# - Never commit `.env.local`. Never put the Supabase *service_role* key here or
#   anywhere in the client app.
